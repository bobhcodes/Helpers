<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="urn:ietf:params:xml:ns:metalink" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="metalink" type="urn:metalinkType" xmlns:urn="urn:ietf:params:xml:ns:metalink"/>
	<xs:complexType name="originType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute type="xs:string" name="dynamic"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="publisherType">
		<xs:sequence>
			<xs:element type="xs:string" name="name"/>
			<xs:element type="xs:string" name="url"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="hashType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute type="xs:string" name="type" use="optional"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="piecesType">
		<xs:sequence>
			<xs:element type="xs:string" name="hash" maxOccurs="unbounded" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute type="xs:int" name="length"/>
		<xs:attribute type="xs:string" name="type"/>
	</xs:complexType>
	<xs:complexType name="urlType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute type="xs:string" name="location" use="optional"/>
				<xs:attribute type="xs:byte" name="priority" use="optional"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="fileType">
		<xs:sequence>
			<xs:element type="xs:long" name="size"/>
			<xs:element type="urn:hashType" name="hash" maxOccurs="unbounded" minOccurs="0" xmlns:urn="urn:ietf:params:xml:ns:metalink"/>
			<xs:element type="urn:piecesType" name="pieces" xmlns:urn="urn:ietf:params:xml:ns:metalink"/>
			<xs:element type="urn:urlType" name="url" maxOccurs="unbounded" minOccurs="0" xmlns:urn="urn:ietf:params:xml:ns:metalink"/>
		</xs:sequence>
		<xs:attribute type="xs:string" name="name"/>
	</xs:complexType>
	<xs:complexType name="metalinkType">
		<xs:sequence>
			<xs:element type="xs:string" name="generator"/>
			<xs:element type="urn:originType" name="origin" xmlns:urn="urn:ietf:params:xml:ns:metalink"/>
			<xs:element type="xs:dateTime" name="published"/>
			<xs:element type="urn:publisherType" name="publisher" xmlns:urn="urn:ietf:params:xml:ns:metalink"/>
			<xs:element type="urn:fileType" name="file" xmlns:urn="urn:ietf:params:xml:ns:metalink"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
