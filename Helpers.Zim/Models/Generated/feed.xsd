<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.w3.org/2005/Atom" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="feed" type="atom:feedType" xmlns:atom="http://www.w3.org/2005/Atom"/>

  <xs:complexType name="linkType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute type="xs:string" name="rel" use="optional"/>
        <xs:attribute type="xs:string" name="href"/>
        <xs:attribute type="xs:string" name="type"/>
        <xs:attribute type="xs:long" name="length" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="nameType">
    <xs:sequence>
      <xs:element type="xs:string" name="name"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="entryType">
    <xs:sequence>
      <xs:element type="xs:string" name="id"/>
      <xs:element type="xs:string" name="title"/>
      <xs:element type="xs:dateTime" name="updated"/>
      <xs:element type="xs:string" name="summary"/>
      <xs:element type="xs:string" name="language"/>
      <xs:element type="xs:string" name="name"/>
      <xs:element type="xs:string" name="flavour"/>
      <xs:element type="xs:string" name="category"/>
      <xs:element type="xs:string" name="tags"/>
      <xs:element type="xs:int" name="articleCount"/>
      <xs:element type="xs:int" name="mediaCount"/>
      <xs:element type="atom:linkType" name="link" maxOccurs="unbounded" minOccurs="1" xmlns:atom="http://www.w3.org/2005/Atom"/>
      <xs:element type="atom:nameType" name="author" xmlns:atom="http://www.w3.org/2005/Atom"/>
      <xs:element type="atom:nameType" name="publisher" xmlns:atom="http://www.w3.org/2005/Atom"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="feedType">
    <xs:sequence>
      <xs:element type="xs:string" name="id"/>
      <xs:element type="atom:linkType" name="link" maxOccurs="unbounded" minOccurs="0" xmlns:atom="http://www.w3.org/2005/Atom"/>
      <xs:element type="xs:string" name="title"/>
      <xs:element type="xs:dateTime" name="updated"/>
      <xs:element type="xs:short" name="totalResults"/>
      <xs:element type="xs:byte" name="startIndex"/>
      <xs:element type="xs:short" name="itemsPerPage"/>
      <xs:element type="atom:entryType" name="entry" maxOccurs="unbounded" minOccurs="0" xmlns:atom="http://www.w3.org/2005/Atom"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
